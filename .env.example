[TEMPLATE]
[TEMPLATE]
# Backend Configuration
DATABASE_URL=postgresql://docuflow_user:docuflow_password@localhost:5432/docuflow_db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Authentication Configuration
SECRET_KEY=your-secret-key-here-generate-with-secrets-token-urlsafe-32
SESSION_COOKIE_NAME=docuflow_session
SESSION_MAX_AGE=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Storage Configuration
STORAGE_DIR=storage/documents
MAX_UPLOAD_SIZE=10485760

# Embedding Configuration
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-384
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=384

# Retrieval Configuration
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.3
RETRIEVAL_MAX_CONTEXT_CHARS=8000

# LLM Configuration
# Providers: "fake" (testing), "openai_compatible" (OpenAI, Qwen, Kimi, Ollama, vLLM)
LLM_PROVIDER=fake
LLM_MODEL=fake-llm
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=60.0

# Database Configuration
POSTGRES_USER=docuflow_user
POSTGRES_PASSWORD=docuflow_password
POSTGRES_DB=docuflow_db
POSTGRES_PORT=5432
